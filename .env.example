# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Generate each secret rather than reusing an example string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
LOG_LEVEL=INFO

# --- Postgres ------------------------------------------------------------
# Given as components, never as a connection URI. A URI embeds the password
# in a single string, which is exactly the shape that leaks and the shape
# secret scanners flag.
#
# Port 5442 rather than 5432: a native PostgreSQL may already hold the
# default port, and an ambiguous port lets Django reach the wrong database.
POSTGRES_DB=medix
POSTGRES_USER=medix
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5442

# --- Redis ---------------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Integrations --------------------------------------------------------
# Never point local or staging at RRA production or a live payment provider.
FISCAL_BACKEND=mock
PAYMENTS_BACKEND=mock
